{
  "meta": {
    "name": "VocaMesh design tokens",
    "version": "1.2.0",
    "date": "2026-10-21",
    "themes": ["light", "dark"],
    "density": ["comfortable", "compact"],
    "notes": "黑白灰构成全部静态界面；只有 success / failure / blocked 三种语义状态色。选中态使用中性背景 + 轻阴影 + 字重三重线索。所有值同时在 UI/VocaMesh.pen 的变量中定义（mode 主题轴）。"
  },
  "color": {
    "light": {
      "bg.canvas": "#F7F7F7",
      "bg.surface": "#FFFFFF",
      "bg.subtle": "#F1F1F1",
      "bg.selected": "#FFFFFF",
      "bg.inset": "#FAFAFA",
      "text.primary": "#171717",
      "text.secondary": "#5A5A5A",
      "text.muted": "#6D6D6D",
      "text.inverse": "#FFFFFF",
      "border.default": "#DEDEDE",
      "border.strong": "#BABABA",
      "action.primary.bg": "#1B1B1B",
      "action.primary.hover": "#333333",
      "action.primary.text": "#FFFFFF",
      "action.secondary.bg": "#FFFFFF",
      "focus.outline": "#4B4B4B",
      "status.success": "#187447",
      "status.success.bg": "#EAF4EE",
      "status.failure": "#B13A43",
      "status.failure.bg": "#FBECED",
      "status.blocked": "#8B5A00",
      "status.blocked.bg": "#FBF2E2",
      "status.neutral": "#666666",
      "status.neutral.bg": "#F1F1F1"
    },
    "dark": {
      "bg.canvas": "#101010",
      "bg.surface": "#191919",
      "bg.subtle": "#232323",
      "bg.selected": "#292929",
      "bg.inset": "#1F1F1F",
      "text.primary": "#F4F4F4",
      "text.secondary": "#B9B9B9",
      "text.muted": "#A0A0A0",
      "text.inverse": "#171717",
      "border.default": "#383838",
      "border.strong": "#666666",
      "action.primary.bg": "#F3F3F3",
      "action.primary.hover": "#DCDCDC",
      "action.primary.text": "#171717",
      "action.secondary.bg": "#242424",
      "focus.outline": "#E2E2E2",
      "status.success": "#76D2A0",
      "status.success.bg": "#14261D",
      "status.failure": "#FF9299",
      "status.failure.bg": "#2A1719",
      "status.blocked": "#EBC16B",
      "status.blocked.bg": "#2A2114",
      "status.neutral": "#B5B5B5",
      "status.neutral.bg": "#232323"
    }
  },
  "contrast": {
    "checkedAgainst": { "light": "#FFFFFF", "dark": "#191919" },
    "results": [
      { "pair": "status.success on surface", "light": 5.79, "dark": 9.63, "verdict": "AA" },
      { "pair": "status.failure on surface", "light": 5.91, "dark": 8.22, "verdict": "AA" },
      { "pair": "status.blocked on surface", "light": 5.9, "dark": 10.36, "verdict": "AA" },
      { "pair": "text.primary on surface", "light": 17.6, "dark": 15.2, "verdict": "AAA" },
      { "pair": "text.secondary on surface", "light": 7.1, "dark": 8.9, "verdict": "AAA" },
      { "pair": "text.muted on surface", "light": 5.3, "dark": 7.1, "verdict": "AA" }
    ],
    "note": "状态色在 tinted 背景（*.bg）上重新核算：success 5.3 / failure 5.4 / blocked 5.2（亮色），均 ≥ 4.5:1。灰度模式下依赖图标与文字，不只依赖颜色。"
  },
  "typography": {
    "family": {
      "ui": "-apple-system, BlinkMacSystemFont, 'Segoe UI Variable', 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Inter, sans-serif",
      "mono": "'SF Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace"
    },
    "scale": [
      { "role": "页面主标题", "size": 22, "weight": 600, "lineHeight": 1.25, "letterSpacing": -0.4 },
      { "role": "页面标题(大)", "size": 25, "weight": 600, "lineHeight": 1.25, "letterSpacing": -0.5 },
      { "role": "区块标题", "size": 16, "weight": 600, "lineHeight": 1.3 },
      { "role": "任务/列表标题", "size": 13, "weight": 500, "lineHeight": 1.4 },
      { "role": "正文", "size": 13, "weight": 400, "lineHeight": 1.6 },
      { "role": "辅助文本", "size": 12, "weight": 400, "lineHeight": 1.55 },
      { "role": "元信息", "size": 10.5, "weight": 400, "lineHeight": 1.45 },
      { "role": "分组标签", "size": 10.5, "weight": 600, "letterSpacing": 0.6 },
      { "role": "日志", "size": 10.5, "weight": 400, "family": "mono" }
    ]
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "page": 26 },
  "layout": {
    "pagePadding": { "comfortable": 26, "compact": 20 },
    "blockGap": 12,
    "columnGap": 12,
    "listColumn": 320,
    "railColumn": 340,
    "sectionNavColumn": 200,
    "cardPadding": { "list": 12, "panel": 16, "nav": 8 },
    "titleLeftAt1280": 266
  },
  "radius": { "badge": 4, "control": 6, "card": 8, "dialog": 10, "pill": 999 },
  "sizing": {
    "rowHeight": { "comfortable": 34, "compact": 30 },
    "controlHeight": { "comfortable": 32, "compact": 28 },
    "sidebarWidth": { "expanded": 240, "medium": 200, "collapsed": 60 },
    "inspectorWidth": 360,
    "contentPadding": { "comfortable": 26, "compact": 20 }
  },
  "elevation": {
    "selected": "0 1px 3px rgb(0 0 0 / 10%), 0 4px 10px rgb(0 0 0 / 5%)",
    "selectedDark": "0 1px 4px rgb(0 0 0 / 48%), 0 3px 12px rgb(0 0 0 / 25%)",
    "overlay": "0 8px 24px rgb(0 0 0 / 12%)",
    "overlayDark": "0 8px 24px rgb(0 0 0 / 45%)",
    "dialog": "0 16px 48px rgb(0 0 0 / 18%)",
    "focusRing": "2px solid var(--focus.outline), offset 2px"
  },
  "motion": {
    "fast": "120ms",
    "base": "160ms",
    "max": "180ms",
    "reduced": "0ms (prefers-reduced-motion 或 设置中开启“减少动态效果”)"
  }
}
